# Text generation: Google Gemini (server-only). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional live search (Brave Search API)
BRAVE_SEARCH_API_KEY=

# Image generation: Pollinations (https://enter.pollinations.ai)
# Leave the key empty to use the free classic API (about one image per 45 s, small logo-free 768px images).
# With a key: no rate limit, larger images, and model choice (flux, zimage, gptimage, nanobanana, seedream, kontext ...).
POLLINATIONS_API_KEY=sk_EthgiJVhp31xJktwVa2py9eSgIfLL3Ic
POLLINATIONS_IMAGE_MODEL=flux
# Set to "off" to skip image generation entirely
IMAGE_GENERATION=on
