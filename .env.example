# Text generation: Google Gemini (server-only). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional live search (Brave Search API)
BRAVE_SEARCH_API_KEY=

# Image generation: Ideogram
IDEOGRAM_API_KEY=
# Set to "off" to skip image generation entirely
IMAGE_GENERATION=on
